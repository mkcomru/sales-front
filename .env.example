# Environment Variables Example
# Copy this file to .env.local for local development
# For production, create .env.production

# API proxy target (Vite dev server proxies /api to this URL)
# For local pulse backend: http://127.0.0.1:8081
# Omit or leave empty to use default: https://backend.ai-gency.ru
# API_PROXY_TARGET=http://127.0.0.1:8081

# API Base URL
# Leave empty to use Vite proxy in development (configured in vite.config.ts)
# Required for: Production environments
# Example: https://backend.ai-gency.ru
VITE_API_BASE_URL=

# Node Environment (automatically set by Vite - do not set manually)
# NODE_ENV=development